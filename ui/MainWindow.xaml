<!--
    githerd MainWindow.xaml
    List+detail editor. Theme is merged in from Theme.xaml at load time
    by config-ui.ps1, so the styles referenced here resolve at runtime.
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="githerd — Configuration"
    Width="980" Height="720"
    MinWidth="820" MinHeight="600"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />        <!-- 0 header -->
            <RowDefinition Height="Auto" />        <!-- 1 error banner -->
            <RowDefinition Height="*" />           <!-- 2 main two-pane area -->
            <RowDefinition Height="Auto" />        <!-- 3 final command card -->
            <RowDefinition Height="Auto" />        <!-- 4 footer buttons -->
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="githerd" Style="{DynamicResource DisplayTitle}" />
            <TextBlock Text="Configure repositories and the post-sync command."
                       Style="{DynamicResource Subhead}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- ===== Error banner (hidden by default) ===== -->
        <Border x:Name="ErrorBox" Grid.Row="1"
                Style="{DynamicResource ErrorBanner}"
                Margin="0,0,0,16"
                Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Style="{DynamicResource ErrorBannerText}" />
        </Border>

        <!-- ===== Main two-pane area ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: repo list -->
            <Border Grid.Column="0" Style="{DynamicResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="REPOSITORIES" Style="{DynamicResource SectionLabel}"
                                   VerticalAlignment="Center" Margin="0" />
                        <TextBlock x:Name="RepoCount" DockPanel.Dock="Right"
                                   Style="{DynamicResource Subhead}"
                                   VerticalAlignment="Center"
                                   Text="0" />
                    </DockPanel>

                    <ListBox x:Name="RepoList" Grid.Row="1"
                             Style="{DynamicResource RepoListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding name}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Ink}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding path}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Muted}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnAdd"    Style="{DynamicResource SecondaryButtonSmall}"
                                Content="+ Add repository" />
                        <Button x:Name="BtnRemove" Style="{DynamicResource DangerButtonSmall}"
                                Content="Remove" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: detail editor -->
            <Border Grid.Column="2" Style="{DynamicResource CardSoft}">
                <Grid x:Name="DetailPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="SELECTED REPOSITORY" Style="{DynamicResource SectionLabel}" />

                    <!-- Name -->
                    <TextBlock Grid.Row="1" Text="Name" Style="{DynamicResource FieldLabel}" />
                    <TextBox  x:Name="TxtName" Grid.Row="2" Style="{DynamicResource TextBoxStyle}" />

                    <!-- Path + Browse -->
                    <TextBlock Grid.Row="3" Text="Path" Style="{DynamicResource FieldLabel}" Margin="0,16,0,4" />
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPath" Grid.Column="0" Style="{DynamicResource TextBoxStyle}" />
                        <Button  x:Name="BtnBrowse" Grid.Column="1"
                                 Style="{DynamicResource SecondaryButtonSmall}"
                                 Content="Browse…" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Grid.Row="5" Style="{DynamicResource Hint}" Margin="0,6,0,0"
                               Text="Absolute (C:\code\my-repo) or relative to where you run sync.bat (.\my-repo)." />

                    <!-- Master -->
                    <TextBlock Grid.Row="6" Text="Master branch" Style="{DynamicResource FieldLabel}" Margin="0,16,0,4" />
                    <TextBox  x:Name="TxtMaster" Grid.Row="7" Style="{DynamicResource TextBoxStyle}"
                             VerticalAlignment="Top" />

                    <!-- Auto-merge -->
                    <CheckBox x:Name="ChkAutoMerge" Grid.Row="8"
                              Style="{DynamicResource CheckBoxStyle}"
                              Content="Auto-merge upstream/master into the working branch after sync"
                              Margin="0,18,0,0" />
                </Grid>
            </Border>

            <!-- Empty-state overlay (shown when no repo selected) -->
            <Border x:Name="EmptyState" Grid.Column="2"
                    Style="{DynamicResource CardSoft}"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="No repository selected"
                               FontFamily="{DynamicResource FontDisplay}"
                               FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Pick a repository on the left, or add a new one."
                               Style="{DynamicResource Subhead}"
                               Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Final command card ===== -->
        <Border Grid.Row="3" Style="{DynamicResource Card}" Margin="0,20,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="POST-SYNC COMMAND"
                               Style="{DynamicResource SectionLabel}" Margin="0" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Worker timeout (s)" Style="{DynamicResource Hint}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="TxtTimeout" Style="{DynamicResource TextBoxStyle}"
                                 Width="80" MinHeight="32" Padding="10,6"
                                 HorizontalContentAlignment="Right" />
                    </StackPanel>
                </DockPanel>

                <TextBox x:Name="TxtFinal" Grid.Row="1"
                         Style="{DynamicResource TextAreaStyle}"
                         Height="96" />

                <TextBlock Grid.Row="2" Style="{DynamicResource Hint}" Margin="0,6,0,0"
                           Text="Runs once after every repo finishes. Leave blank to skip. No double-quotes — see docs/configuration.md." />
            </Grid>
        </Border>

        <!-- ===== Footer ===== -->
        <DockPanel Grid.Row="4" LastChildFill="False" Margin="0,20,0,0">
            <TextBlock DockPanel.Dock="Left"
                       Text="Save writes config.json next to sync.bat."
                       Style="{DynamicResource Hint}"
                       VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnCancel"  Style="{DynamicResource SecondaryButton}" Content="Cancel" />
                <Button x:Name="BtnSave"    Style="{DynamicResource SecondaryButton}" Content="Save"     Margin="10,0,0,0" />
                <Button x:Name="BtnSaveRun" Style="{DynamicResource PrimaryButton}"   Content="Save &amp; Run" Margin="10,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
