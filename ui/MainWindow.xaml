<!--
    GitHerd MainWindow.xaml
    List+detail editor. Theme is merged in from Theme.xaml at load time
    by config-ui.ps1, so the styles referenced here resolve at runtime.
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GitHerd — Configuration"
    Width="1280" Height="820"
    MinWidth="1080" MinHeight="700"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />        <!-- 0 header -->
            <RowDefinition Height="Auto" />        <!-- 1 error banner -->
            <RowDefinition Height="*" />           <!-- 2 main two-pane area -->
            <RowDefinition Height="Auto" />        <!-- 3 footer buttons -->
        </Grid.RowDefinitions>

        <!-- ===== Header (inline) ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="BtnImport"
                        Style="{DynamicResource SecondaryButtonSmall}"
                        Content="↑ Import"
                        ToolTip="Import config from a .json file" />
                <Button x:Name="BtnExport"
                        Style="{DynamicResource SecondaryButtonSmall}"
                        Content="↓ Export"
                        Margin="6,0,0,0"
                        ToolTip="Export current config to a .json file" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="GitHerd" Style="{DynamicResource DisplayTitle}" />
                <TextBlock Text="·" Style="{DynamicResource Subhead}"
                           FontSize="20" Margin="14,0,14,0" VerticalAlignment="Center" />
                <TextBlock Text="Configure repositories and the post-sync command."
                           Style="{DynamicResource Subhead}" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- ===== Error banner (hidden by default) ===== -->
        <Border x:Name="ErrorBox" Grid.Row="1"
                Style="{DynamicResource ErrorBanner}"
                Margin="0,0,0,14"
                Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Style="{DynamicResource ErrorBannerText}" />
        </Border>

        <!-- ===== Main two-pane area: left = wide repo list, right = detail+post-sync stack ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Left: repo list -->
            <Border Grid.Column="0" Style="{DynamicResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="REPOSITORIES" Style="{DynamicResource SectionLabel}"
                                   VerticalAlignment="Center" Margin="0" />
                        <TextBlock x:Name="RepoCount" DockPanel.Dock="Right"
                                   Style="{DynamicResource Subhead}"
                                   VerticalAlignment="Center"
                                   Text="0" />
                    </DockPanel>

                    <ListBox x:Name="RepoList" Grid.Row="1"
                             Style="{DynamicResource RepoListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding name}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Ink}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding name}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Untitled repository"
                                                   Style="{DynamicResource PlaceholderName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="Collapsed">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize"   Value="15" />
                                                    <Setter Property="FontStyle"  Value="Italic" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding name}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <TextBlock Text="{Binding path}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Muted}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding path}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <Border Style="{DynamicResource BadgePill}">
                                            <TextBlock Style="{DynamicResource BadgeTextMuted}">
                                                <Run Text="branch:&#160;" />
                                                <Run Text="{Binding master}" FontWeight="SemiBold"
                                                     Foreground="{DynamicResource Ink}" />
                                            </TextBlock>
                                        </Border>

                                        <!-- auto-merge badge: coral when on, muted when off -->
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"      Value="{DynamicResource SurfaceCard}" />
                                                    <Setter Property="BorderBrush"     Value="{DynamicResource Hairline}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="CornerRadius"    Value="5" />
                                                    <Setter Property="Padding"         Value="8,3" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding auto_merge}" Value="True">
                                                            <Setter Property="Background"  Value="{DynamicResource PrimaryWashed}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize"   Value="11" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                        <Setter Property="Text"       Value="pull only" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding auto_merge}" Value="True">
                                                                <Setter Property="Text"       Value="↺ auto-merge" />
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryActive}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnAdd"    Style="{DynamicResource SecondaryButtonSmall}"
                                Content="+ Add repository" />
                        <Button x:Name="BtnRemove" Style="{DynamicResource DangerButtonSmall}"
                                Content="Remove" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right column: detail editor + post-sync card stacked -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />          <!-- detail editor takes remaining space -->
                    <RowDefinition Height="Auto" />       <!-- post-sync card -->
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{DynamicResource CardSoft}">
                    <Grid x:Name="DetailPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="SELECTED REPOSITORY" Style="{DynamicResource SectionLabel}" />

                        <TextBlock Grid.Row="1" Text="Name" Style="{DynamicResource FieldLabel}" />
                        <TextBox  x:Name="TxtName" Grid.Row="2" Style="{DynamicResource TextBoxStyle}" />

                        <TextBlock Grid.Row="3" Text="Path" Style="{DynamicResource FieldLabel}" Margin="0,12,0,4" />
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtPath" Grid.Column="0" Style="{DynamicResource TextBoxStyle}" />
                            <Button  x:Name="BtnBrowse" Grid.Column="1"
                                     Style="{DynamicResource SecondaryButtonSmall}"
                                     Content="Browse…" Margin="6,0,0,0" />
                        </Grid>
                        <TextBlock Grid.Row="5" Style="{DynamicResource Hint}" Margin="0,4,0,0"
                                   Text="Absolute or relative to where you run sync.bat." />

                        <TextBlock Grid.Row="6" Text="Master branch" Style="{DynamicResource FieldLabel}" Margin="0,12,0,4" />
                        <TextBox  x:Name="TxtMaster" Grid.Row="7" Style="{DynamicResource TextBoxStyle}"
                                 VerticalAlignment="Top" />

                        <CheckBox x:Name="ChkAutoMerge" Grid.Row="8"
                                  Style="{DynamicResource CheckBoxStyle}"
                                  Content="Auto-merge upstream/master into the working branch"
                                  Margin="0,14,0,0" />
                    </Grid>
                </Border>

                <!-- Empty-state overlay -->
                <Border x:Name="EmptyState" Grid.Row="0"
                        Style="{DynamicResource CardSoft}"
                        Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="No repository selected"
                                   FontFamily="{DynamicResource FontDisplay}"
                                   FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Pick a repository on the left, or add a new one."
                                   Style="{DynamicResource Subhead}"
                                   Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Post-sync card pinned to bottom of right column -->
                <Border Grid.Row="1" Style="{DynamicResource Card}" Margin="0,14,0,0" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="POST-SYNC COMMAND"
                                       Style="{DynamicResource SectionLabel}" Margin="0"
                                       VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="Timeout (s)" Style="{DynamicResource Hint}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="TxtTimeout" Style="{DynamicResource TextBoxStyle}"
                                         Width="72" MinHeight="28" Padding="8,4"
                                         HorizontalContentAlignment="Right" />
                            </StackPanel>
                        </DockPanel>

                        <TextBox x:Name="TxtFinal" Grid.Row="1"
                                 Style="{DynamicResource TextBoxStyle}"
                                 AcceptsReturn="False"
                                 TextWrapping="Wrap"
                                 MinLines="2" MaxLines="3"
                                 FontFamily="{DynamicResource FontMono}"
                                 FontSize="12"
                                 VerticalContentAlignment="Top"
                                 Padding="10,8"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Grid.Row="2" Style="{DynamicResource Hint}" Margin="0,4,0,0"
                                   Text="Single line — wraps for readability. Runs once after every repo finishes." />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Footer ===== -->
        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Left"
                       Text="Save writes config.json next to sync.bat."
                       Style="{DynamicResource Hint}"
                       VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnCancel"  Style="{DynamicResource SecondaryButton}" Content="Cancel" />
                <Button x:Name="BtnSave"    Style="{DynamicResource SecondaryButton}" Content="Save"     Margin="10,0,0,0" />
                <Button x:Name="BtnSaveRun" Style="{DynamicResource PrimaryButton}"   Content="Save &amp; Run" Margin="10,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
